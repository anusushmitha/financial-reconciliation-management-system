# LENDGUARD AI — Staging Environment Variables Template
# Copy to .env.staging and inject real enterprise secrets from Cloud KMS / HashiCorp Vault.
# NEVER commit production passwords or credentials to version control.

# Database
STAGING_DB_HOST=staging-db.internal
STAGING_DB_PORT=5432
STAGING_DB_NAME=lendguard_staging
STAGING_DB_USER=lendguard_app
STAGING_DB_PASSWORD=REPLACE_WITH_KMS_GENERATED_PASSWORD

# API & Security
ASPNETCORE_ENVIRONMENT=Staging
REQUIRE_HTTPS=true
SEED_TEST_USERS=false
STAGING_JWT_SECRET=REPLACE_WITH_MINIMUM_64_CHARACTER_RANDOM_SECRET_KEY
STAGING_JWT_EXPIRY_MINUTES=120
STAGING_FILE_STORAGE_PATH=/var/lendguard/storage

# AI Microservice
STAGING_AI_SERVICE_BASE_URL=http://ai-service.internal:8000
STAGING_AI_SERVICE_KEY=REPLACE_WITH_SECURE_INTERNAL_AI_KEY
STAGING_LLM_PROVIDER=mock
STAGING_LLM_API_KEY=REPLACE_WITH_HOSTED_PROVIDER_KEY
STAGING_LLM_MODEL=gpt-4o-mini
