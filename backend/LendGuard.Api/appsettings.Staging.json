{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=staging-db.internal;Port=5432;Database=lendguard_staging;Username=lendguard_app;Password=${STAGING_DB_PASSWORD};SslMode=Require"
  },
  "SEED_TEST_USERS": false,
  "REQUIRE_HTTPS": true,
  "JWT_SECRET": "${STAGING_JWT_SECRET}",
  "JWT_EXPIRY_MINUTES": "120",
  "FILE_STORAGE_PATH": "/var/lendguard/storage",
  "AI_SERVICE_BASE_URL": "http://ai-service.internal:8000",
  "AI_SERVICE_KEY": "${STAGING_AI_SERVICE_KEY}"
}
