# ========================================================
# LENDGUARD AI - Environment Configuration Variables
# ========================================================

# Database (PostgreSQL 16)
DATABASE_URL=Host=localhost;Port=5433;Database=lendguard;Username=app;Password=lendguard_password
POSTGRES_DB=lendguard
POSTGRES_USER=app
POSTGRES_PASSWORD=lendguard_password
POSTGRES_PORT=5433

# Business Backend API (ASP.NET Core 8 Web API)
PORT=5000
ASPNETCORE_ENVIRONMENT=Development
JWT_SECRET=LendGuard_Super_Secret_Key_For_Jwt_Authentication_Must_Be_Long_2026
JWT_EXPIRY_MINUTES=480
FILE_STORAGE_PATH=storage

# AI Backend Microservice (Python FastAPI + scikit-learn)
AI_SERVICE_BASE_URL=http://localhost:8000
AI_SERVICE_KEY=lendguard_internal_ai_secret_key_2026
LLM_PROVIDER=mock
LLM_API_KEY=your_hosted_llm_api_key_here
LLM_MODEL=gpt-4o-mini

# Frontend (React 18 + TypeScript + Vite)
VITE_API_BASE_URL=http://localhost:5000/api/v1
