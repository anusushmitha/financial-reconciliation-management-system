{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Error"
    }
  },
  "AllowedHosts": "lendguard.internal.company.com",
  "ConnectionStrings": {
    "DefaultConnection": "Host=prod-pg-ha.internal;Port=5432;Database=lendguard_prod;Username=lendguard_app;Password=${PROD_DB_PASSWORD};SslMode=VerifyFull"
  },
  "SEED_TEST_USERS": false,
  "REQUIRE_HTTPS": true,
  "JWT_SECRET": "${PROD_JWT_SECRET}",
  "JWT_EXPIRY_MINUTES": "60",
  "FILE_STORAGE_PATH": "/var/lendguard/storage",
  "AI_SERVICE_BASE_URL": "http://ai-service-internal.prod.svc.cluster.local:8000",
  "AI_SERVICE_KEY": "${PROD_AI_SERVICE_KEY}"
}
